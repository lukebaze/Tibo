# SePay Configuration
SEPAY_MERCHANT_ID=SP-TEST-XXXXXXX
SEPAY_SECRET_KEY=spsk_test_xxxxxxxxxxxxx
SEPAY_ENV=sandbox  # or 'production'

# SePay Webhook Configuration
SEPAY_WEBHOOK_AUTH_TYPE=hmac  # or 'api_key', 'oauth2', 'none'
SEPAY_WEBHOOK_SECRET=your_webhook_hmac_secret
SEPAY_WEBHOOK_API_KEY=your_webhook_api_key  # only for api_key mode

# PayFS Webhook Configuration
PAYFS_WEBHOOK_SECRET=your_payfs_webhook_secret  # per webhook, from the Client Portal
PAYFS_WEBHOOK_API_KEY=your_payfs_webhook_api_key  # arrives as X-Client-API-Key
# PAYFS_API_TOKEN=your_payfs_api_token  # only for REST calls; API reference not yet published

# Polar Configuration
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxx
POLAR_SERVER=sandbox  # or 'production'
POLAR_ORG_ID=org_xxxxxxxxxxxxx

# Polar Webhook Configuration
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx  # exactly as shown in webhook settings

# Creem Configuration
CREEM_API_KEY=creem_test_xxx  # creem_test_ = test mode, creem_ = live
CREEM_SERVER=test  # or 'prod'; must match the key prefix

# Creem Webhook Configuration
CREEM_WEBHOOK_SECRET=whsec_xxx  # per endpoint; test and live endpoints differ

# Dodo Payments Configuration
DODO_PAYMENTS_API_KEY=your_test_mode_api_key  # test and live keys differ; no documented prefix
DODO_PAYMENTS_ENVIRONMENT=test_mode  # or 'live_mode' (SDK default is live_mode)

# Dodo Payments Webhook Configuration
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxx  # per endpoint; test and live endpoints differ

# Lemon Squeezy Configuration
LEMONSQUEEZY_API_KEY=your_api_key  # test-mode and live-mode keys differ; keys expire after one year
LEMONSQUEEZY_STORE_ID=12345

# Lemon Squeezy Webhook Configuration
LEMONSQUEEZY_WEBHOOK_SECRET=your_signing_secret  # chosen when creating the webhook; test and live webhooks differ

# Paddle Billing Configuration (sandbox and live are separate accounts)
PADDLE_API_KEY=pdl_sdbx_apikey_xxx  # pdl_sdbx_ = sandbox, pdl_live_ = live; server only
PADDLE_ENV=sandbox  # or 'production'; must match the key
PADDLE_CLIENT_TOKEN=test_xxx  # Paddle.js client-side token (test_ / live_), safe for frontend

# Paddle Webhook Configuration
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx  # per notification destination; sandbox and live differ

# PayPal Configuration
PAYPAL_CLIENT_ID=your_client_id  # public; also used by the JS SDK
PAYPAL_CLIENT_SECRET=your_client_secret  # server-only
PAYPAL_ENV=sandbox  # or 'live'; sandbox and live apps have separate credentials

# PayPal Webhook Configuration
PAYPAL_WEBHOOK_ID=your_webhook_id  # ID of the webhook subscription (not a secret); differs per app/environment

# Optional: Database or other configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379
