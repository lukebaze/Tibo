{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentkit.best/schemas/diagram/architecture.schema.json",
  "title": "ArchitectureDiagramIR",
  "type": "object",
  "required": ["schema_version", "diagram_type", "meta", "components", "connections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "diagram_type": { "type": "string", "enum": ["architecture"] },
    "meta": { "$ref": "common.schema.json#/definitions/DiagramMeta" },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "role": { "type": "string", "enum": ["cloud", "vpc", "cluster", "trust-boundary", "private-network", "external-zone"], "default": "trust-boundary" },
          "components": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/Identifier" }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "description": { "$ref": "common.schema.json#/definitions/SafeText" },
          "role": { "type": "string", "enum": ["frontend", "backend", "database", "cache", "queue", "storage", "gateway", "auth", "external", "worker"], "default": "backend" },
          "tags": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/SafeText" } },
          "layer": { "type": "integer", "minimum": 0, "maximum": 10 }
        }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "from": { "$ref": "common.schema.json#/definitions/Identifier" },
          "to": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "protocol": { "$ref": "common.schema.json#/definitions/SafeText" },
          "kind": { "type": "string", "enum": ["sync", "async", "stream", "fallback", "bi-directional"], "default": "sync" }
        }
      }
    }
  }
}
