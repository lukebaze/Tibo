{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentkit.best/schemas/diagram/dataflow.schema.json",
  "title": "DataflowDiagramIR",
  "type": "object",
  "required": ["schema_version", "diagram_type", "meta", "nodes", "flows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "diagram_type": { "type": "string", "enum": ["dataflow"] },
    "meta": { "$ref": "common.schema.json#/definitions/DiagramMeta" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "description": { "$ref": "common.schema.json#/definitions/SafeText" },
          "role": { "type": "string", "enum": ["source", "transform", "store", "sink", "consumer", "filter", "governance"], "default": "transform" },
          "stage": { "$ref": "common.schema.json#/definitions/Identifier" },
          "classification": { "type": "string", "enum": ["public", "internal", "confidential", "pii", "restricted"], "default": "internal" }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "from": { "$ref": "common.schema.json#/definitions/Identifier" },
          "to": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "schema_type": { "$ref": "common.schema.json#/definitions/SafeText" },
          "volume": { "$ref": "common.schema.json#/definitions/SafeText" }
        }
      }
    }
  }
}
