{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentkit.best/schemas/diagram/sequence.schema.json",
  "title": "SequenceDiagramIR",
  "type": "object",
  "required": ["schema_version", "diagram_type", "meta", "participants", "messages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "diagram_type": { "type": "string", "enum": ["sequence"] },
    "meta": { "$ref": "common.schema.json#/definitions/DiagramMeta" },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "role": { "type": "string", "enum": ["client", "service", "database", "gateway", "external", "queue"], "default": "service" }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["from", "to", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "from": { "$ref": "common.schema.json#/definitions/Identifier" },
          "to": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "kind": { "type": "string", "enum": ["sync-call", "async-signal", "return", "self-call", "error"], "default": "sync-call" },
          "note": { "$ref": "common.schema.json#/definitions/SafeText" }
        }
      }
    }
  }
}
