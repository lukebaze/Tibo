{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentkit.best/schemas/diagram/workflow.schema.json",
  "title": "WorkflowDiagramIR",
  "type": "object",
  "required": ["schema_version", "diagram_type", "meta", "steps", "transitions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "diagram_type": { "type": "string", "enum": ["workflow"] },
    "meta": { "$ref": "common.schema.json#/definitions/DiagramMeta" },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "role": { "type": "string", "enum": ["user", "frontend", "orchestrator", "worker", "approver", "system"], "default": "system" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "description": { "$ref": "common.schema.json#/definitions/SafeText" },
          "lane": { "$ref": "common.schema.json#/definitions/Identifier" },
          "kind": { "type": "string", "enum": ["start", "action", "decision", "wait", "subprocess", "terminal-success", "terminal-failure"], "default": "action" },
          "tags": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/SafeText" } }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/Identifier" },
          "from": { "$ref": "common.schema.json#/definitions/Identifier" },
          "to": { "$ref": "common.schema.json#/definitions/Identifier" },
          "label": { "$ref": "common.schema.json#/definitions/SafeText" },
          "condition": { "$ref": "common.schema.json#/definitions/SafeText" },
          "kind": { "type": "string", "enum": ["normal", "branch-true", "branch-false", "retry", "exception"], "default": "normal" }
        }
      }
    }
  }
}
