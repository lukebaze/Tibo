{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram org-chart spec",
  "type": "object",
  "required": [
    "root"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "root": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/properties/root"
          }
        }
      }
    }
  }
}
