{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram scatter spec",
  "type": "object",
  "required": [
    "points"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        }
      }
    },
    "x_label": {
      "type": "string"
    },
    "y_label": {
      "type": "string"
    }
  }
}
