{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram dp-security-matrix spec",
  "type": "object",
  "required": [
    "rows",
    "cols",
    "cells"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
