{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram it-state spec",
  "type": "object",
  "required": [
    "state",
    "transitions"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "current state name"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "trigger"
        ],
        "properties": {
          "to": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          }
        }
      }
    }
  }
}
