{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram pyramid spec",
  "type": "object",
  "required": [
    "levels"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string"
      },
      "description": "top to bottom order"
    }
  }
}
