{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram radar spec",
  "type": "object",
  "required": [
    "axes",
    "series"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "axes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
