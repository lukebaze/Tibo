{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram layers spec",
  "type": "object",
  "required": [
    "layers"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
