{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ak:diagram bar spec",
  "type": "object",
  "required": [
    "categories",
    "values"
  ],
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "full"
      ],
      "default": "light"
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "y_label": {
      "type": "string"
    }
  }
}
