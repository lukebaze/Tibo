    "title": "Auth Sequence Flow",
    "visual_preset": "blueprint",
    "theme": "dark"
  },
  "participants": [
    { "id": "user", "label": "Browser", "role": "client" },
    { "id": "api", "label": "API Gateway", "role": "gateway" },
