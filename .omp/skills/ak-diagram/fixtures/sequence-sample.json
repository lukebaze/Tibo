    { "from": "auth", "to": "db", "label": "SELECT user", "kind": "sync-call" },
    { "from": "db", "to": "auth", "label": "user row", "kind": "return" },
    { "from": "auth", "to": "api", "label": "JWT Token", "kind": "return" },
    { "from": "api", "to": "user", "label": "200 OK + Cookie", "kind": "return" }
